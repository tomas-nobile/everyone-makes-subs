# Everything is optional if you use the /setup wizard. In Docker, the minimum is the key.
GEMINI_API_KEY=
PORT=8080
ADMIN_PASSWORD=              # if empty, /setup asks for it
PUBLIC_MODE=tailscale        # tailscale | cloudflare | lan | url
PUBLIC_URL=                  # with PUBLIC_MODE=url (behind your own proxy)
TARGET_LANGS=es,en,pt
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.5-flash-lite
TRANSLATE_FALLBACK_MODEL=gemini-3.1-flash-lite
AUX_MODEL=gemini-3.5-flash   # glossary, agenda and summary
SESSION_ROTATE_SEC=510
SESSION_HARD_CUT_SEC=580
FORCE_COMMIT_MS=4500
VAD_END_MS=500               # hybrid VAD: close the phrase after this much silence (0 = only the ASR's endpointing)
ASR_SILENCE_MS=              # server-side VAD silenceDurationMs (empty = model default)
SENTENCE_MIN_WORDS=5         # segmenter: commit at a sentence end with this many words
COMMA_MIN_WORDS=8            # segmenter: commit at a comma/conjunction with this many words
MAX_PHRASE_WORDS=18          # segmenter: longest phrase cut out of a long final
TRANSLATE_STREAM=1           # publish the Spanish translation as soon as it closes in the streamed JSON
TRANSLATE_CONCURRENCY=2      # parallel translation calls per room (4 on a billed project)
KEEP_ALIVE=1                 # keep the HTTPS connection to Gemini open between phrases
JOB_SPEED=1                  # "Subtitle a video": feed the audio at N× real time
DEMO=0                       # 1: demo rooms with the samples at startup
DEMO_STAGES=2                # how many demo rooms (Auditorium, Room 2 … Room N, cycling en/es/mixed)
FAKE_BACKEND=0               # 1: replay samples/*.transcript.json, no key needed
DATA_DIR=./data
